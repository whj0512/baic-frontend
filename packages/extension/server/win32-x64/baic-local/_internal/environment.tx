EnvironmentView:
    'Environment' '{' (elements+=Element)* '}'
;

Element: Component | Connector ;

Component :type=ComponentType name=ID ';' ;

Connector:
    'Connect' 'from' source=ID 'to' target=ID
    '{'
        interactions+=Interaction
    '}'
    ';'
;

ComponentType:
    Machine="Machine"
  | Human="Human"
  | Device="Device"
  | Controller="Controller"
  | ControlUnit="ControlUnit"
  | FunctionalModule="FunctionalModule"
;

Interaction:
    'Interaction' name=ID '{' interactionItem = InteractionItem '}' ';'
;

InteractionItem: Signal | Event ;
Signal: 'Signal' data=ID ;
Event: 'Event' data=ID ;

ID: /[\u4e00-\u9fa5a-zA-Z0-9_\/][\u4e00-\u9fa5a-zA-Z0-9_\-()\/]*/;

Comment:
    /\/\/.*$/
    | /\/\*[\s\S]*?\*\//
;