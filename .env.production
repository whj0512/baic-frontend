# 生产环境配置
# 请将 your-server-ip 替换为服务器实际 IP 或域名，9093 替换为 Nginx 监听的端口

# ── 后端 REST API ──────────────────────────────────────────────────
# 使用 Nginx /api/ 反向代理，相对路径即可
VITE_API_BASE_URL=/api

# ── 项目协作 WebSocket（后端 :8000/ws/）────────────────────────────
# WebSocket 必须使用绝对地址，不能使用相对路径
VITE_WS_BASE_URL=ws://10.69.41.208:9093

# ── DSL Language Server WebSocket（各 LSP 对应独立端口）──────────────
# internalConstraints  →  grammar: entity.tx        (本地 :3000)
VITE_LSP_WS_INTERNAL_CONSTRAINTS=ws://10.69.41.208:9093/lsp/entity

# environment          →  grammar: environment.tx   (本地 :3001)
VITE_LSP_WS_ENVIRONMENT=ws://10.69.41.208:9093/lsp/environment

# interaction / moduleResponses  →  grammar: scenario.tx  (本地 :3002)
VITE_LSP_WS_INTERACTION=ws://10.69.41.208:9093/lsp/scenario

# internalComposition  →  grammar: composition.tx   (本地 :3003)
VITE_LSP_WS_INTERNAL_COMPOSITION=ws://10.69.41.208:9093/lsp/composition