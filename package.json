{
  "name": "baic-requirements-management-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @baic/webview",
    "dev:demo": "npm run dev:demo --workspace @baic/webview",
    "dev:platform": "npm run dev:platform --workspace @baic/webview",
    "build": "npm run build:webview && npm run build:extension",
    "build:debug-extension": "npm run build:webview && npm run build:extension",
    "build:webview": "npm run build --workspace @baic/webview",
    "build:webview:demo": "npm run build:demo --workspace @baic/webview",
    "build:demo-extension": "npm run build:webview:demo && npm run build:extension",
    "build:platform": "npm run build:platform --workspace @baic/webview",
    "build:extension": "npm run build --workspace packages/extension",
    "lint": "npm run lint --workspace @baic/webview",
    "preview": "npm run preview --workspace @baic/webview"
  }
}
